---
layout: null
permalink: /articles.json
---
[
{%- for post in site.posts -%}
{%- assign words = post.content | number_of_words -%}
{%- assign summary = post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 240 -%}
  {
    "id": {{ post.id | slugify | jsonify }},
    "title": {{ post.title | jsonify }},
    "category": {{ post.topic | default: "HVDC" | jsonify }},
    "summary": {{ summary | jsonify }},
    "standard": {{ post.standard | default: "" | jsonify }},
    "date": {{ post.date | date: "%d %b %Y" | jsonify }},
    "author": {{ post.author | default: site.author | jsonify }},
    "readTime": "{{ words | divided_by: 180 | plus: 1 }} min read",
    "tags": {{ post.tags | jsonify }},
    "image": {{ post.image | default: "" | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "content": {{ post.content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
